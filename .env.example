# Copy this file to .env.local and fill in real values.
# Never commit .env.local or real secrets.

# --- Supabase (auth, database, storage) ---
# From your Supabase project: Project Settings -> API.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY is the anon/publishable key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Service role key. Server-only; never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Local development database (docker-compose) ---
DATABASE_URL=postgres://parking:parking@localhost:5433/parking

# --- Stripe Connect (payments + payouts) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Maps ---
# MapLibre needs a tile/style source. Fill in when the map milestone lands.
NEXT_PUBLIC_MAP_STYLE_URL=
